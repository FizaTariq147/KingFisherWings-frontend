{
  "bundles": {
    "Arimo": {
      "family": "Arimo",
      "regular": "reports/fonts/Arimo-Regular.ttf",
      "bold": "reports/fonts/Arimo-Bold.ttf"
    },
    "NotoSans": {
      "family": "Noto Sans",
      "regular": "reports/fonts/NotoSans-Regular.ttf",
      "bold": "reports/fonts/NotoSans-Bold.ttf"
    },
    "LiberationMono": {
      "family": "Liberation Mono",
      "regular": "reports/fonts/LiberationMono-Regular.ttf",
      "bold": "reports/fonts/LiberationMono-Bold.ttf"
    },
    "NotoNaskhArabic": {
      "family": "Noto Naskh Arabic",
      "regular": "reports/fonts/NotoNaskhArabic-Regular.ttf",
      "bold": "reports/fonts/NotoNaskhArabic-Regular.ttf"
    }
  },
  "rules": [
    { "match": "consolas|courier|liberation\\s*mono|monospace", "bundle": "LiberationMono" },
    { "match": "naskh|arabic", "bundle": "NotoNaskhArabic" },
    { "match": "arial\\s*unicode", "bundle": "Arimo" },
    { "match": "noto|dejavu|freesans|symbol", "bundle": "NotoSans" },
    { "match": "arial|helvetica|arimo", "bundle": "Arimo" },
    { "match": ".*", "bundle": "NotoSans" }
  ]
}
