{
  "meta": {
    "title": "Customer portal quote → booking lifecycle demo data",
    "purpose": "Test every customer-booked quotation job type and each commercial gate through convert / Ops handoff.",
    "seedCommand": "npm run seed:portal-quotes",
    "env": [
      "API_BASE_URL (optional)",
      "E2E_TENANT_SLUG",
      "E2E_STAFF_EMAIL",
      "E2E_STAFF_PASSWORD",
      "E2E_PORTAL_EMAIL",
      "E2E_PORTAL_PASSWORD"
    ],
    "uiPaths": {
      "portalBook": "/portal/book",
      "portalQuotes": "/portal/quotes",
      "portalQuoteDetail": "/portal/quotes/:id",
      "staffQuotes": "/quotations",
      "staffQuoteDetail": "/quotations/:id",
      "staffJobs": "/jobs/:id",
      "nvoccBookings": "/nvocc/bookings",
      "portalAdminInbox": "/portal-admin/inbox"
    }
  },
  "lifecycleStages": [
    {
      "stage": "requested",
      "status": "DRAFT | SUBMITTED",
      "actor": "Customer",
      "action": "POST /portal/quotations/request",
      "whatToTest": "Quote appears in staff inbox / quotations list; portal shows pending."
    },
    {
      "stage": "sent",
      "status": "SENT | CUSTOMER_REVIEW",
      "actor": "Staff",
      "action": "submit → approve → send (+ optional lines / apply-tariff)",
      "whatToTest": "Customer can Accept / Reject / Counter in portal."
    },
    {
      "stage": "approved",
      "status": "APPROVED",
      "actor": "Customer",
      "action": "POST /portal/quotations/:id/accept",
      "whatToTest": "Booking form unlocks; no job yet for gated / mode-form flows."
    },
    {
      "stage": "booking_form_complete",
      "status": "APPROVED (+ BOOKING_FORM_COMPLETE signal)",
      "actor": "Customer",
      "action": "Portal booking form Mark complete (compliance API or portal message payload)",
      "whatToTest": "Sea/Land/Road/Courier auto-convert; Air/NVOCC stay approved for Ops invoice gate."
    },
    {
      "stage": "converted",
      "status": "CONVERTED",
      "actor": "System / Staff",
      "action": "POST /quotations/:id/convert-to-job (mode booking-form family)",
      "whatToTest": "Job shell + draft invoice path; barcode / Ops panels."
    },
    {
      "stage": "rejected",
      "status": "REJECTED",
      "actor": "Customer",
      "action": "POST /portal/quotations/:id/reject",
      "whatToTest": "Terminal closed; no booking form."
    }
  ],
  "flowFamilies": {
    "mode_booking_form_convert": {
      "jobTypes": [
        "SEA_FCL_EXPORT",
        "SEA_FCL_IMPORT",
        "SEA_LCL_EXPORT",
        "SEA_LCL_IMPORT",
        "LAND",
        "ROAD_FREIGHT",
        "COURIER"
      ],
      "afterCustomerAccept": "Wait for portal booking form → convert to job"
    },
    "gated_air_nvocc": {
      "jobTypes": ["AIR_EXPORT", "AIR_IMPORT", "NVOCC_EXPORT", "NVOCC_IMPORT"],
      "afterCustomerAccept": "Portal booking form → Ops send-invoice (Air job shell / NVOCC booking); no auto convert on approve"
    },
    "other_portal": {
      "jobTypes": ["CUSTOMS_CLEARANCE", "SERVICE_JOB", "WAREHOUSE"],
      "afterCustomerAccept": "Standard commercial accept; exercise portal book + staff send"
    }
  },
