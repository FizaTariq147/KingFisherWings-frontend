# Local Vite proxy (recommended for CORS-free login against Render):
VITE_API_URL=/backend
VITE_API_BASE_URL=/backend

# Or call the API directly (requires backend CORS to allow your origin):
# VITE_API_URL=https://kingfisherwings-backend.onrender.com
# VITE_API_BASE_URL=https://kingfisherwings-backend.onrender.com

# Local-only flags (do not enable for real API login testing)
# VITE_BYPASS_AUTH=true
# VITE_MOCK_API=true

# Playwright E2E (optional — authenticated suites skip when unset)
# PLAYWRIGHT_BASE_URL=http://localhost:5173
# E2E_TENANT_SLUG=your-tenant-slug
# E2E_TENANT_PASSWORD=your-tenant-admin-password
# E2E_STAFF_EMAIL=staff@example.com
# E2E_STAFF_PASSWORD=staff-temporary-password
# E2E_SUPERADMIN_EMAIL=superadmin@example.com
# E2E_SUPERADMIN_PASSWORD=superadmin-password
