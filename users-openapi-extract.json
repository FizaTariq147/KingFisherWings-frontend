          ]
        },
        "branch_id": {
          "type": "string"
        },
        "department_id": {
          "type": "string"
        },
        "is_salesperson": {
          "type": "boolean"
        },
        "is_cs_rep": {
          "type": "boolean"
        },
        "is_operations": {
          "type": "boolean"
        },
        "is_finance": {
          "type": "boolean"
        },
        "can_see_sales": {
          "type": "boolean"
