  "schemas": {
    "CreateUserDto": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Required only when a super admin is creating this user. Ignored for tenant-scoped callers."
        },
        "email": {
          "type": "string",
          "example": "ahmed@kingfisherwings.com"
        },
        "first_name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "example": "Ahmed"
        },
        "last_name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "example": "Khan"
        },
        "phone": {
          "type": "string",
          "example": "+971501234567"
        },
        "avatar_url": {
          "type": "string"
        },
        "company_id": {
          "type": "string",
          "format": "uuid"
        },
        "branch_id": {
          "type": "string",
          "format": "uuid"
        },
        "department_id": {
          "type": "string",
          "format": "uuid"
        },
        "role": {
          "type": "string",
          "enum": [
            "SUPER_ADMIN",
            "TENANT_ADMIN",
            "BRANCH_MANAGER",
            "FINANCE_MANAGER",
            "ACCOUNTANT",
            "SALES_MANAGER",
            "SALES_EXECUTIVE",
            "OPERATIONS_MANAGER",
            "OPERATIONS_EXECUTIVE",
            "WAREHOUSE_STAFF",
            "HR_MANAGER",
            "CUSTOMER",
            "AGENT",
            "READ_ONLY",
            "DOCUMENTATION",
            "CUSTOMER_SUPPORT",
            "DRIVER"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "INACTIVE",
            "INVITED",
            "SUSPENDED",
            "LOCKED"
          ],
          "default": "INVITED"
        },
        "is_salesperson": {
          "type": "boolean",
          "default": false
        },
        "is_cs_rep": {
          "type": "boolean",
          "default": false
        },
        "is_operations": {
          "type": "boolean",
          "default": false
        },
        "is_finance": {
          "type": "boolean",
          "default": false
        },
        "can_see_sales": {
          "type": "boolean",
          "default": false
        },
        "can_see_cost": {
          "type": "boolean",
          "default": false
        },
        "can_see_gp": {
          "type": "boolean",
          "default": false
        },
        "can_see_invoices": {
          "type": "boolean",
          "default": false
        },
        "can_see_payments": {
          "type": "boolean",
          "default": false
        },
        "can_see_bank_balances": {
          "type": "boolean",
          "default": false
        },
        "can_see_ar_ap": {
          "type": "boolean",
          "default": false
        },
        "can_see_mgmt_reports": {
          "type": "boolean",
          "default": false
        },
        "can_see_job_pnl": {
          "type": "boolean",
          "default": false
        },
        "allowed_ips": {
          "description": "Empty array = unrestricted.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_mac_addresses": {
          "description": "Empty array = unrestricted.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "office_hours_start": {
          "type": "string",
          "pattern": "OFFICE_HOURS_REGEX",
          "example": "09:00",
          "description": "24h \"HH:mm\" format."
        },
        "office_hours_end": {
          "type": "string",
          "pattern": "OFFICE_HOURS_REGEX",
          "example": "18:00",
          "description": "24h \"HH:mm\" format."
        },
        "office_hours_timezone": {
          "type": "string",
          "example": "Asia/Dubai"
        },
        "two_factor_enabled": {
          "type": "boolean",
          "default": false
        },
        "max_concurrent_sessions": {
          "type": "number",
          "minimum": 1,
          "maximum": 20,
          "default": 3
        },
        "role_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "permission_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": [
        "email",
        "first_name",
        "last_name",
        "role"
      ]
    },
