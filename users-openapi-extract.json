{
  "paths": {
    "/users": {
      "get": {
        "operationId": "UsersController_findAll",
        "summary": "List users for the current tenant (paginated, filterable).",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 10,
              "type": "number"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Matches first name, last name, email, or phone.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "role",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "SUPER_ADMIN",
                "TENANT_ADMIN",
                "BRANCH_MANAGER",
                "FINANCE_MANAGER",
                "ACCOUNTANT",
                "SALES_MANAGER",
                "SALES_EXECUTIVE",
                "OPERATIONS_MANAGER",
                "OPERATIONS_EXECUTIVE",
                "WAREHOUSE_STAFF",
                "HR_MANAGER",
                "CUSTOMER",
                "AGENT",
                "READ_ONLY",
                "DOCUMENTATION",
                "CUSTOMER_SUPPORT",
                "DRIVER"
              ],
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "ACTIVE",
                "INACTIVE",
                "INVITED",
                "SUSPENDED",
                "LOCKED"
              ],
              "type": "string"
            }
          },
          {
            "name": "sortBy",
            "required": false,
            "in": "query",
            "schema": {
              "default": "created_at",
              "enum": [
                "created_at",
                "updated_at",
                "first_name",
                "last_name",
                "email",
                "last_login_at",
                "status",
                "role"
              ],
              "type": "string"
            }
          },
          {
            "name": "order",
            "required": false,
            "in": "query",
            "schema": {
              "default": "desc",
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string"
            }
          },
          {
            "name": "branch_id",
            "required": false,
            "in": "query",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "department_id",
            "required": false,
            "in": "query",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedUsersResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Users"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "operationId": "UsersController_create",
        "summary": "Create a user. Returns a system-generated temporary password.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Users"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
