        "can_see_payments": {
          "type": "boolean"
        },
        "can_see_bank_balances": {
          "type": "boolean"
        },
        "can_see_ar_ap": {
          "type": "boolean"
        },
        "can_see_mgmt_reports": {
          "type": "boolean"
        },
        "can_see_job_pnl": {
          "type": "boolean"
        },
        "two_factor_enabled": {
          "type": "boolean"
        },
        "email_verified": {
          "type": "boolean"
        },
        "must_change_password": {
          "type": "boolean"
        },
        "last_login_at": {
          "format": "date-time",
          "type": "string"
        },
        "locked_until": {
          "format": "date-time",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "created_by_user_id": {
          "type": "string"
        },
        "created_by_tenant_id": {
          "type": "string"
        },
        "created_by_super_admin_id": {
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "id",
        "tenant_id",
        "email",
        "first_name",
        "last_name",
        "full_name",
        "role",
        "status",
        "is_salesperson",
        "is_cs_rep",
        "is_operations",
        "is_finance",
        "can_see_sales",
        "can_see_cost",
        "can_see_gp",
        "can_see_invoices",
        "can_see_payments",
        "can_see_bank_balances",
        "can_see_ar_ap",
        "can_see_mgmt_reports",
        "can_see_job_pnl",
        "two_factor_enabled",
        "email_verified",
        "must_change_password",
        "created_at",
        "updated_at"
      ]
    },
